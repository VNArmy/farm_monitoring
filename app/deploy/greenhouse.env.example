# /etc/greenhouse/greenhouse.env: ghi đè cấu hình cho cả collector và web (install.sh tạo từ file này nếu chưa có).
# Sửa xong: sudo systemctl restart greenhouse-collector greenhouse-web

# Thư mục backup hằng ngày. Nên là ổ USB hoặc ổ khác thẻ nhớ (mount tại /mnt/greenhouse-backup).
#GREENHOUSE_BACKUP_DIR=/mnt/greenhouse-backup

# Cổng web app sau Caddy (chỉ nghe loopback) và cổng màn HMI.
#GREENHOUSE_WEB_PORT=8080
#GREENHOUSE_HMI_PORT=8081
